<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head', { title: 'Tabela de Solicitação' }) %>

<style>
   * {
      margin: 0;
      padding: 0;
   }

   body {
      padding-top: 2.5rem;
   }

   .caixa-externa {
      max-width: 100%;
   }

   .table-container {
      max-height: 75vh;
      overflow-y: auto;
      overflow-x: hidden;
      min-height: 75vh;
   }

   .table-container table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
   }

   .table-container th,
   .table-container td {
      word-wrap: break-word;
      white-space: nowrap;
      border: none !important;
   }

   .table-container thead th {
      position: sticky;
      top: 0;
      background-color: rgb(231, 161, 9);
      color: white;
      border-left: 1px solid white !important;
      border-right: none !important;
      border-top: none !important;
      border-bottom: 1px solid white !important;
      z-index: 1;
   }

   .table-container thead th:last-child {
      border-right: none !important;
   }

   .btn-action {
      width: 70px;
   }

   .modal.fade .modal-dialog {
      transition: transform 0.25s ease-in-out, opacity 0.25s ease-in-out;
      transform: translateY(-10%);
      opacity: 0;
   }

   .modal.show .modal-dialog {
      transform: translateY(0);
      opacity: 1;
   }

   .situacao-select {
      width: 100% !important;
      padding: 2px;
      font-size: 0.9rem;
   }

   /* Ajuste das colunas */
   .table-container th:nth-child(1),
   .table-container td:nth-child(1) {
      width: 2%;
   }

   .table-container th:nth-child(2),
   .table-container td:nth-child(2) {
      width: 2%;
   }

   /* DESCRIÇÃO */
   .table-container th:nth-child(3),
   .table-container td:nth-child(3) {
      width: 48%;
      word-break: break-word;
      white-space: pre-line;
      max-width: 250px;
   }

   /* QUANTIDADE */
   .table-container th:nth-child(4),
   .table-container td:nth-child(4) {
      width: 3%;
   }

   /* SOLICITANTE */
   .table-container th:nth-child(5),
   .table-container td:nth-child(5) {
      width: 30%;
      max-width: 120px;
      word-break: break-word;
      white-space: pre-line;
      overflow: hidden;
      text-overflow: ellipsis;
   }

   /* SITUAÇÃO */
   .table-container th:nth-child(6),
   .table-container td:nth-child(6) {
      width: 8%;
   }

   /* NUP */
   .table-container th:nth-child(7),
   .table-container td:nth-child(7) {
      width: 11%;
   }

   /* DETALHES */
   .table-container th:nth-child(8),
   .table-container td:nth-child(8) {
      width: 10%;
   }

   @media (max-width: 1920px) {
      .table-container {
         max-height: 56vh;
      }
   }
</style>

<body>
   <%- include('../partials/header') %>
   <div class="caixa p-4 mx-auto">
      <div class="border caixa-externa p-4 shadow-sm rounded">
         <div class="row align-items-center mb-3 px-3">
            <div class="col d-flex justify-content-between align-items-center bg-success py-2 rounded" style="border-bottom: 4px solid orange;">
               <h2 class="text-white mt-0 fw-bold flex-grow-1 text-center">Tabela de Solicitação</h2>
               <div class="d-flex align-items-center">
                  <input type="text" id="searchInput" class="form-control me-2" placeholder="Pesquisar..." style="width: 200px;" aria-label="Pesquisar solicitações">
                  <label for="formato" class="text-white me-2">Formato:</label>
                  <select id="formato" class="form-select form-select-md me-2" style="width: auto;" aria-label="Formato de exportação">
                     <option value="pdf">PDF</option>
                     <option value="excel">Excel</option>
                  </select>
                  <a href="#" id="exportarBtn" class="btn btn-outline-light btn-header fw-bold">Exportar</a>
               </div>
            </div>
         </div>
         <div class="table-container">
            <table class="table table-striped table-hover mb-0" id="solicitacaoTable">
               <thead>
                  <tr>
                     <th class="text-center px-0 align-middle">ID</th>
                     <th class="text-center px-0 align-middle">Data</th>
                     <th class="text-center px-0 align-middle">Descrição</th>
                     <th class="text-center px-0 align-middle">Qtde.</th>
                     <th class="text-center px-0 align-middle">Solicitante</th>
                     <th class="text-center px-0 align-middle">Situação</th>
                     <th class="text-center px-0 align-middle">NUP</th>
                     <th class="text-center px-0 align-middle">Detalhes</th>
                  </tr>
               </thead>
               <tbody>
                  <% if (solicitacao && solicitacao.length > 0) { %>
                     <% solicitacao.forEach(function(item) { %>
                        <tr>
                           <td class="py-1 text-center align-middle"><%= item.id %></td>
                           <td class="py-1 text-center align-middle"><%= new Date(item.data_da_solicitacao).toLocaleDateString('pt-BR') %></td>
                           <td class="py-1 text-left align-middle"><%= item.descricao %></td>
                           <td class="py-1 text-center align-middle"><%= item.quantidade %></td>
                           <td class="py-1 text-left align-middle"><%= item.solicitante %></td>
                           <td class="py-1 text-center align-middle">
                              <% if (userRole === 'admin') { %>
                                 <select class="form-select form-select-sm situacao-select" data-id="<%= item.id %>" data-original-value="<%= item.situacao %>" aria-label="Alterar situação da solicitação">
                                    <option value="PENDENTE" <%= item.situacao === 'PENDENTE' ? 'selected' : '' %>>Pendente</option>
                                    <option value="ADQUIRIDO" <%= item.situacao === 'ADQUIRIDO' ? 'selected' : '' %>>Adquirido</option>
                                 </select>
                              <% } else { %>
                                 <span><%= item.situacao %></span>
                              <% } %>
                           </td>
                           <td class="py-1 align-middle text-center">
                              <% if (item.nup) { %>
                                 <%= item.nup %>
                              <% } else { %>
                                 [NUP não disponível]
                              <% } %>
                           </td>
                           <td class="py-1 text-center align-middle">
                              <button type="button" class="btn btn-secondary btn-sm btn-details btn-action" data-id="<%= item.id %>" aria-label="Ver detalhes da solicitação">Detalhes</button>
                              <a href="/solicitacao/editar/<%= item.id %>" class="btn btn-warning btn-sm btn-edit btn-action">Editar</a>
                              <a href="/solicitacao/excluir/<%= item.id %>" class="btn btn-danger btn-sm btn-delete btn-action" data-id="<%= item.id %>">Excluir</a>
                           </td>
                        </tr>
                     <% }); %>
                  <% } else { %>
                     <tr>
                        <td colspan="8" class="text-center align-middle">Nenhuma solicitação encontrada.</td>
                     </tr>
                  <% } %>
               </tbody>
            </table>
         </div>
      </div>
   </div>

   <!-- Incluindo o SweetAlert2 via CDN -->
   <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

   <!-- Scripts para Bootstrap -->
   <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
   ></script>
   <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
   ></script>

   <!-- Scripts para funcionalidades da tabela -->
   <script>
      document.addEventListener('DOMContentLoaded', () => {
         // Função para filtrar linhas com base no termo de pesquisa
         function filterRows(searchTerm) {
            const table = document.getElementById('solicitacaoTable');
            const rows = table.querySelectorAll('tbody tr');
            rows.forEach(row => {
               const cells = row.querySelectorAll('td');
               const descricao = cells[2].textContent.toLowerCase();
               const solicitante = cells[4].textContent.toLowerCase();
               const situacao = cells[5].querySelector('select') ? cells[5].querySelector('select').value.toLowerCase() : cells[5].textContent.toLowerCase();
               const nup = cells[6].textContent.toLowerCase();
               const matches = 
                  descricao.includes(searchTerm) ||
                  solicitante.includes(searchTerm) ||
                  situacao.includes(searchTerm) ||
                  nup.includes(searchTerm);
               row.style.display = matches ? '' : 'none';
            });
         }

         // Evento de busca
         const searchInput = document.getElementById('searchInput');
         searchInput.addEventListener('input', (event) => {
            const searchTerm = event.target.value.toLowerCase();
            filterRows(searchTerm);
         });

         // Obter o papel do usuário da sessão
         const userRole = '<%= userRole %>';

         // Atualizar situação com confirmação e verificação de permissão
         document.querySelectorAll('.situacao-select').forEach(select => {
            select.addEventListener('change', async (event) => {
               const selectElement = event.target;
               const solicitacaoId = selectElement.getAttribute('data-id');
               const novaSituacao = selectElement.value;
               const originalValue = selectElement.getAttribute('data-original-value');

               // Verificar se o usuário é administrador
               if (userRole !== 'admin') {
                  selectElement.value = originalValue; // Reverte a seleção
                  await Swal.fire({
                     icon: 'error',
                     title: 'Acesso Negado!',
                     text: 'Você não tem permissão para alterar a situação. Apenas administradores podem realizar esta ação.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
                  return;
               }

               // Evita ação se o valor não mudou
               if (novaSituacao === originalValue) {
                  return;
               }

               // Confirmação com SweetAlert2
               const result = await Swal.fire({
                  title: 'Confirmar alteração',
                  text: `Tem certeza que deseja modificar para "${novaSituacao}"?`,
                  icon: 'question',
                  showCancelButton: true,
                  confirmButtonText: 'Sim',
                  cancelButtonText: 'Não',
                  confirmButtonColor: '#28a745',
                  cancelButtonColor: '#dc3545',
                  willClose: () => {
                     document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                     document.body.classList.remove('modal-open');
                     document.body.style.paddingRight = '';
                  }
               });

               if (!result.isConfirmed) {
                  selectElement.value = originalValue; // Reverte se cancelado
                  return;
               }

               try {
                  const response = await fetch(`/solicitacao/${solicitacaoId}/situacao`, {
                     method: 'PUT',
                     headers: {
                        'Content-Type': 'application/json',
                     },
                     body: JSON.stringify({ situacao: novaSituacao }),
                  });

                  if (!response.ok) {
                     throw new Error('Erro ao atualizar situação');
                  }

                  // Atualiza o valor original após sucesso
                  selectElement.setAttribute('data-original-value', novaSituacao);

                  await Swal.fire({
                     icon: 'success',
                     title: 'Sucesso!',
                     text: 'Situação atualizada com sucesso!',
                     timer: 2000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
               } catch (error) {
                  console.error('Erro ao atualizar situação:', error);
                  selectElement.value = originalValue; // Reverte em caso de erro
                  await Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: 'Não foi possível atualizar a situação. Tente novamente.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
               }
            });
         });

         // Botão "Exportar"
         const exportarBtn = document.getElementById('exportarBtn');
         exportarBtn.addEventListener('click', (event) => {
            event.preventDefault();
            const formato = document.getElementById('formato').value;
            window.location.href = `/solicitacao/relatorio/solicitacoes?formato=${formato}`;
         });

         // Botão "Detalhes"
         document.querySelectorAll('.btn-details').forEach(button => {
            button.addEventListener('click', async (event) => {
               const solicitacaoId = event.target.getAttribute('data-id');
               try {
                  const response = await fetch(`/solicitacao/${solicitacaoId}`);
                  if (!response.ok) throw new Error('Erro ao buscar detalhes da solicitação');
                  const item = await response.json();
                  const modalHtml = `
                     <div class="modal fade" id="infoSolicitacaoModal" tabindex="-1" aria-labelledby="infoSolicitacaoModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                           <div class="modal-content">
                              <div class="modal-header bg-success text-white d-flex justify-content-between">
                                 <h3 class="modal-title ms-3" id="infoSolicitacaoModalLabel">Informações da Solicitação</h3>
                                 <button type="button" class="btn text-white" data-bs-dismiss="modal" aria-label="Close">
                                    <i class="fa fa-times fa-lg"></i>
                                 </button>
                              </div>
                              <div class="modal-body">
                                 <div class="card">
                                    <div class="card-body pb-0">
                                       <h5 class="card-title">${item.descricao || 'N/A'}</h5>
                                       <p class="card-text">
                                          <h5 class="bg-primary text-white p-2">Dados da Solicitação</h5>
                                          <strong>ID:</strong> ${item.id || 'N/A'} <br/>
                                          <strong>Data da Solicitação:</strong> ${new Date(item.data_da_solicitacao).toLocaleDateString('pt-BR') || 'N/A'} <br/>
                                          <strong>Quantidade:</strong> ${item.quantidade || 'N/A'} <br/>
                                          <strong>Solicitante:</strong> ${item.solicitante || 'N/A'} <br/>
                                          <strong>Situação:</strong> ${item.situacao || 'N/A'} <br/>
                                          <strong>NUP:</strong> ${item.nup || 'N/A'} <br/>
                                          <strong>Observação:</strong> ${item.observacao || 'N/A'} <br/>
                                       </p>
                                    </div>
                                 </div>
                              </div>
                           </div>
                        </div>
                     </div>`;
                  const modalDiv = document.createElement('div');
                  modalDiv.innerHTML = modalHtml;
                  document.body.appendChild(modalDiv);
                  const infoSolicitacaoModal = new bootstrap.Modal(document.getElementById('infoSolicitacaoModal'), {
                     backdrop: true,
                     focus: true
                  });
                  infoSolicitacaoModal.show();
                  infoSolicitacaoModal._element.addEventListener('hidden.bs.modal', () => {
                     modalDiv.remove();
                     document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                     document.body.classList.remove('modal-open');
                     document.body.style.paddingRight = '';
                  });
               } catch (error) {
                  console.error('ERRO AO BUSCAR INFORMAÇÕES DA SOLICITAÇÃO:', error.message.toUpperCase());
                  await Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: 'Não foi possível carregar os detalhes da solicitação.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
               }
            });
         });

         // Scripts para os botões "Editar" e "Excluir"
         const editButtons = document.querySelectorAll('.btn-edit');
         const deleteButtons = document.querySelectorAll('.btn-delete');

         editButtons.forEach(button => {
            button.addEventListener('click', async (event) => {
               if (userRole !== 'admin') {
                  event.preventDefault();
                  await Swal.fire({
                     icon: 'error',
                     title: 'Acesso Negado!',
                     text: 'Você não tem permissão para editar solicitações. Apenas administradores podem realizar esta ação.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
               }
            });
         });

         deleteButtons.forEach(button => {
            button.addEventListener('click', async (event) => {
               event.preventDefault();
               const solicitacaoId = button.getAttribute('data-id');
               const url = `/solicitacao/excluir/${solicitacaoId}`;

               if (userRole !== 'admin') {
                  await Swal.fire({
                     icon: 'error',
                     title: 'Acesso Negado!',
                     text: 'Você não tem permissão para excluir solicitações. Apenas administradores podem realizar esta ação.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
                  return;
               }

               const result = await Swal.fire({
                  title: 'Confirmar exclusão',
                  text: 'Você tem certeza que deseja excluir esta solicitação? Esse processo é irreversível.',
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonText: 'Sim',
                  cancelButtonText: 'Não',
                  confirmButtonColor: '#28a745',
                  cancelButtonColor: '#dc3545',
                  willClose: () => {
                     document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                     document.body.classList.remove('modal-open');
                     document.body.style.paddingRight = '';
                  }
               });

               if (!result.isConfirmed) {
                  return;
               }

               try {
                  const response = await fetch(url, { method: 'DELETE' });
                  if (!response.ok) {
                     const result = await response.json();
                     throw new Error(result.error || 'Erro ao excluir solicitação');
                  }

                  await Swal.fire({
                     icon: 'success',
                     title: 'Sucesso!',
                     text: 'Solicitação excluída com sucesso!',
                     timer: 2000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
                  location.reload();
               } catch (error) {
                  console.error('Erro ao excluir solicitação:', error);
                  await Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: error.message || 'Não foi possível excluir a solicitação. Tente novamente.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                     willClose: () => {
                        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.paddingRight = '';
                     }
                  });
               }
            });
         });
      });
   </script>
</body>
</html>