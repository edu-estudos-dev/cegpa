<!DOCTYPE html>
<html lang="pt-BR">
   <%- include('../partials/head', { title: 'Tombos Usados' }) %>

   <style>
      * {
         margin: 0;
         padding: 0;
      }

      body {
         padding-top: 2.5rem;
      }

      .botoes {
         margin-bottom: 1.9rem;
      }

      .btn-view-upload {
         width: 120px;
         margin-left: 5px;
      }

      .table-container {
         max-height: 60vh;
         overflow-y: auto;
         overflow-x: hidden;
         min-height: 70vh;
      }

      .table-container table {
         width: 100%;
         border-collapse: separate;
         border-spacing: 0;
      }

      .table-container th,
      .table-container td {
         word-wrap: break-word;
         white-space: nowrap;
         border: none !important;
      }

      .table-container thead th {
         position: sticky;
         top: 0;
         background-color: rgb(231, 161, 9);
         color: white;
         border-left: 1px solid white !important;
         border-right: none !important;
         border-top: none !important;
         border-bottom: 1px solid white !important;
         z-index: 1;
      }

      .table-container thead th:last-child {
         border-right: none !important;
      }

      .btn-action {
         width: 70px;
      }

      .modal.fade .modal-dialog {
         transition: transform 0.25s ease-in-out, opacity 0.25s ease-in-out;
         transform: translateY(-10%);
         opacity: 0;
      }

      .modal.show .modal-dialog {
         transform: translateY(0);
         opacity: 1;
      }

      /* Ajuste das colunas */
      .table-container th:nth-child(1), /* ID */
      .table-container td:nth-child(1) {
         width: 3%;
      }

      .table-container th:nth-child(2), /* Saída */
      .table-container td:nth-child(2) {
         width: 5%;
      }

      .table-container th:nth-child(3), /* Descrição */
      .table-container td:nth-child(3) {
         width: 15%;
      }

      .table-container th:nth-child(4), /* Tombo */
      .table-container td:nth-child(4) {
         width: 5%;
      }

      .table-container th:nth-child(5), /* Destino */
      .table-container td:nth-child(5) {
         width: 5%;
      }

      .table-container th:nth-child(6), /* NUP */
      .table-container td:nth-child(6) {
         width: 5%;
      }

      .table-container th:nth-child(7), /* Doc. Saída */
      .table-container td:nth-child(7) {
         width: 8%;
      }

      .table-container th:last-child, /* Ações */
      .table-container td:last-child {
         width: 5%;
      }

      @media (max-width: 1920px) {
         .table-container {
            max-height: 56vh;
         }
      }

      .filter-container {
         display: flex;
         align-items: center;
         gap: 15px;
         margin-bottom: 1rem;
         flex-wrap: wrap;
      }

      .filter-container form {
         display: flex;
         align-items: center;
         gap: 15px;
         flex-wrap: nowrap;
         margin-left: auto;
         margin-right: 1rem;
      }

      .filter-container label {
         margin-bottom: 0;
         font-weight: bold;
         font-size: 0.9rem;
         color: #333;
      }

      .filter-container input {
         padding: 0.375rem 0.5rem;
         font-size: 0.875rem;
         border-radius: 0.25rem;
         border: 1px solid #ced4da;
         width: 250px;
         transition: border-color 0.2s ease-in-out;
      }

      .filter-container input:focus {
         border-color: #007bff;
         outline: none;
         box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
      }

      .filter-container button {
         padding: 0.375rem 1rem;
         font-size: 0.875rem;
         white-space: nowrap;
      }

      @media (max-width: 768px) {
         .filter-container form {
            flex-wrap: wrap;
            gap: 10px;
         }
         .filter-container input {
            width: 120px;
         }
      }

      .sortable {
         cursor: pointer;
         position: relative;
         padding-right: 30px;
      }

      .sortable::before,
      .sortable::after {
         content: '';
         position: absolute;
         right: 5px;
         width: 0;
         height: 0;
         border-left: 6px solid transparent;
         border-right: 6px solid transparent;
         opacity: 0.7;
         transition: opacity 0.3s ease, border-color 0.3s ease;
      }

      .sortable::before {
         border-bottom: 6px solid #ffffff;
         top: 8px;
      }

      .sortable::after {
         border-top: 6px solid #ffffff;
         bottom: 8px;
      }

      .sortable:hover::before,
      .sortable:hover::after {
         opacity: 1;
      }

      .sort-asc::before {
         border-bottom-color: #122dc4;
         opacity: 1;
      }

      .sort-asc::after {
         opacity: 0.7;
      }

      .sort-desc::after {
         border-top-color: #d40a0a;
         opacity: 1;
      }

      .sort-desc::before {
         opacity: 0.7;
      }
   </style>

   <body>
      <%- include('../partials/header') %>
      <div class="caixa p-4 mx-auto">
         <div class="border caixa-externa p-4 shadow-sm rounded">
            <div class="row align-items-center mb-3 px-3">
               <div
                  class="col d-flex justify-content-between align-items-center bg-success py-2 rounded"
                  style="border-bottom: 4px solid orange"
               >
                  <h2 class="text-white mt-0 fw-bold flex-grow-1 text-center">
                     Tombos Usados
                  </h2>
                  <div class="d-flex align-items-center">
                     <label for="formato" class="text-white me-2"
                        >Formato:</label
                     >
                     <select
                        id="formato"
                        class="form-select form-select-md me-2"
                        style="width: auto"
                     >
                        <option value="pdf">PDF</option>
                        <option value="excel">Excel</option>
                     </select>
                     <a
                        href="#"
                        id="exportarBtn"
                        class="btn btn-outline-light btn-header fw-bold"
                        >Gerar Relatório</a
                     >
                  </div>
               </div>
            </div>
            <div class="filter-container">
               <form action="/tombos-usados" method="GET" id="filterForm">
                  <label for="data_inicial">Data Inicial:</label>
                  <input
                     type="date"
                     id="data_inicial"
                     name="data_inicial"
                     class="form-control"
                     value="<%= data_inicial || '' %>"
                  />
                  <label for="data_final">Data Final:</label>
                  <input
                     type="date"
                     id="data_final"
                     name="data_final"
                     class="form-control"
                     value="<%= data_final || '' %>"
                  />
                  <button type="submit" id="filtrarBtn" class="btn btn-primary">
                     Filtrar
                  </button>
               </form>
            </div>
            <div class="table-container">
               <table class="table table-striped table-hover mb-0">
                  <thead>
                     <tr>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="0"
                        >
                           ID
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="1"
                        >
                           Saída
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="2"
                        >
                           Descrição
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="3"
                        >
                           Tombo
                        </th>
                        <th class="text-center px-0 align-middle">Destino</th>
                        <th class="text-center px-0 align-middle">
                           NUP (Suite)
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="4"
                        >
                           Doc. Saída
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="5"
                        >
                           Valor
                        </th>
                        <th class="text-center px-0 align-middle">Ações</th>
                     </tr>
                  </thead>
                  <tbody id="table-body">
                     <% if (tombosUsados && tombosUsados.length > 0) { %> <%
                     tombosUsados.forEach(function(tombo) { %>
                     <tr>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.id %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <% if (tombo.data_saida && !isNaN(new
                           Date(tombo.data_saida).getTime())) { %> <%= new
                           Date(tombo.data_saida).toLocaleDateString('pt-BR') %>
                           <% } else { %> N/A <% } %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.descricao ? tombo.descricao.toUpperCase() :
                           'N/A' %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.tombo %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.destino ? tombo.destino.toUpperCase() :
                           'N/A' %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.referencia ? tombo.referencia.toUpperCase()
                           : 'N/A' %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.doc_saida ? tombo.doc_saida.toUpperCase() :
                           'N/A' %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= tombo.valor && !isNaN(parseFloat(tombo.valor)) ?
                           parseFloat(tombo.valor).toLocaleString('pt-BR', {
                           style: 'currency', currency: 'BRL' }) : 'R$ 0,00' %>
                        </td>
                        <td class="py-1 text-center align-middle w-10">
                           <button
                              type="button"
                              class="btn btn-secondary btn-sm btn-action btn-details"
                              data-id="<%= tombo.id %>"
                           >
                              Detalhes
                           </button>
                           <% if (userRole === 'admin') { %>
                           <button
                              type="button"
                              class="btn btn-danger btn-sm btn-action btn-revert"
                              data-id="<%= tombo.id %>"
                           >
                              Reverter
                           </button>
                           <% } %> <% console.log('Tombo:', tombo.tombo,
                           'has_pdf:', tombo.has_pdf, 'userRole:', userRole); %>
                           <% if (tombo.has_pdf) { %>
                           <a
                              href="/download-pdf/<%= tombo.tombo %>"
                              class="btn btn-info btn-sm"
                              title="Visualizar Upload"
                              target="_blank"
                           >
                              Visualizar Pdf
                           </a>
                           <% } %>
                        </td>
                     </tr>
                     <% }); %> <% } else { %>
                     <tr>
                        <td colspan="9" class="text-center align-middle">
                           Ainda não há tombos usados
                        </td>
                     </tr>
                     <% } %>
                  </tbody>
               </table>
            </div>
         </div>
      </div>

      <!-- Incluindo o SweetAlert2 via CDN -->
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

      <!-- Scripts para Bootstrap -->
      <script
         src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
         integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
         crossorigin="anonymous"
      ></script>
      <script
         src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
         integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
         crossorigin="anonymous"
      ></script>

      <script>
         // Passa o role do usuário do backend para o JavaScript
         const userRole =
            '<%= typeof userRole !== "undefined" ? userRole : "user" %>';

         document.addEventListener('DOMContentLoaded', () => {
            const attachDetailsEvents = () => {
               const viewButtons = document.querySelectorAll('.btn-details');
               viewButtons.forEach((button) => {
                  button.addEventListener('click', async (event) => {
                     const itemId = event.target.getAttribute('data-id');
                     const url = `/visualizar/tombo-usado/${itemId}`;
                     try {
                        console.log('Fetching data for tombo ID:', itemId);
                        const response = await fetch(url);
                        if (!response.ok) {
                           if (response.status === 404) {
                              throw new Error('Tombo não encontrado');
                           }
                           throw new Error(
                              `ERRO: ${response.statusText.toUpperCase()}`
                           );
                        }
                        const tombo = await response.json();
                        console.log('Data fetched:', tombo);
                        if (tombo) {
                           const modalHtml = `
                           <div class="modal fade" id="infoTomboModal" tabindex="-1" aria-labelledby="infoTomboModalLabel" aria-hidden="true">
                              <div class="modal-dialog modal-dialog-centered">
                                 <div class="modal-content">
                                    <div class="modal-header bg-success text-white d-flex justify-content-between">
                                       <h3 class="modal-title ms-3" id="infoTomboModalLabel">Informações do Tombo Usado</h3>
                                       <button type="button" class="btn text-white" data-bs-dismiss="modal" aria-label="Close">
                                          <i class="fa fa-times fa-lg"></i>
                                       </button>
                                    </div>
                                    <div class="modal-body">
                                       <div class="card">
                                          <div class="card-body pb-0">
                                             <h5 class="card-title">${
                                                tombo.descricao
                                                   ? tombo.descricao.toUpperCase()
                                                   : 'N/A'
                                             }</h5>
                                             <p class="card-text">
                                                <h5 class="bg-danger text-white p-2">DADOS DA SAÍDA</h5>
                                                <strong>TOMBO:</strong> ${
                                                   tombo.tombo
                                                } <br/>
                                                <strong>DATA DA SAÍDA:</strong> ${
                                                   tombo.data_saida &&
                                                   !isNaN(
                                                      new Date(
                                                         tombo.data_saida
                                                      ).getTime()
                                                   )
                                                      ? new Date(
                                                           tombo.data_saida
                                                        ).toLocaleDateString(
                                                           'pt-BR'
                                                        )
                                                      : 'N/A'
                                                } <br/>
                                                <strong>DESTINO:</strong> ${
                                                   tombo.destino
                                                      ? tombo.destino.toUpperCase()
                                                      : 'N/A'
                                                } <br/>
                                                <strong>REFERÊNCIA:</strong> ${
                                                   tombo.referencia
                                                      ? tombo.referencia.toUpperCase()
                                                      : 'N/A'
                                                } <br/>
                                                <strong>DOC. SAÍDA:</strong> ${
                                                   tombo.doc_saida
                                                      ? tombo.doc_saida.toUpperCase()
                                                      : 'N/A'
                                                } <br/>
                                                <strong>VALOR:</strong> ${
                                                   tombo.valor &&
                                                   !isNaN(
                                                      parseFloat(tombo.valor)
                                                   )
                                                      ? parseFloat(
                                                           tombo.valor
                                                        ).toLocaleString(
                                                           'pt-BR',
                                                           {
                                                              style: 'currency',
                                                              currency: 'BRL',
                                                           }
                                                        )
                                                      : 'R$ 0,00'
                                                } <br/>
                                                <strong>NOME DO RECEBEDOR:</strong> ${
                                                   tombo.nome_recebedor
                                                      ? tombo.nome_recebedor.toUpperCase()
                                                      : 'N/A'
                                                } <br/>
                                                <strong>POSTO/GRADUAÇÃO:</strong> ${
                                                   tombo.posto_grad
                                                      ? tombo.posto_grad.toUpperCase()
                                                      : 'N/A'
                                                } <br/>
                                                <strong>MAT. FUNCIONAL:</strong> ${
                                                   tombo.mf_recebedor
                                                      ? tombo.mf_recebedor
                                                      : 'N/A'
                                                } <br/>
                                                <strong>TELEFONE:</strong> ${
                                                   tombo.tel_recebedor
                                                      ? tombo.tel_recebedor
                                                      : 'N/A'
                                                } <br/>
                                                <strong>OBSERVAÇÃO:</strong> ${
                                                   tombo.observacao
                                                      ? tombo.observacao.toUpperCase()
                                                      : 'N/A'
                                                } <br/>
                                             </p>
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                              </div>
                           </div>`;
                           const modalDiv = document.createElement('div');
                           modalDiv.innerHTML = modalHtml;
                           document.body.appendChild(modalDiv);
                           const infoTomboModal = new bootstrap.Modal(
                              document.getElementById('infoTomboModal'),
                              {
                                 backdrop: true,
                                 focus: true,
                              }
                           );
                           infoTomboModal.show();
                           infoTomboModal._element.addEventListener(
                              'hidden.bs.modal',
                              () => {
                                 modalDiv.remove();
                              }
                           );
                        }
                     } catch (error) {
                        console.error(
                           'ERRO AO BUSCAR INFORMAÇÕES DO TOMBO:',
                           error.message.toUpperCase()
                        );
                        Swal.fire({
                           icon: 'error',
                           title: 'Erro!',
                           text:
                              error.message === 'Tombo não encontrado'
                                 ? 'O tombo solicitado não foi encontrado.'
                                 : 'Erro ao carregar os detalhes. Verifique o console para mais informações.',
                           timer: 3000,
                           timerProgressBar: true,
                           showConfirmButton: false,
                        });
                     }
                  });
               });
            };
            // Inicializar eventos dos botões "Detalhes"
            attachDetailsEvents();

            // Validação do formulário antes do envio
            const filterForm = document.getElementById('filterForm');
            filterForm.addEventListener('submit', (event) => {
               const dataInicial =
                  document.getElementById('data_inicial').value;
               const dataFinal = document.getElementById('data_final').value;

               if (!dataInicial || !dataFinal) {
                  event.preventDefault();
                  Swal.fire({
                     icon: 'warning',
                     title: 'Atenção!',
                     text: 'Por favor, selecione ambas as datas inicial e final.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                  });
               } else if (new Date(dataInicial) > new Date(dataFinal)) {
                  event.preventDefault();
                  Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: 'A data inicial não pode ser posterior à data final.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                  });
               }
            });

            // Evento para o botão "Exportar"
            const exportarBtn = document.getElementById('exportarBtn');
            exportarBtn.addEventListener('click', (event) => {
               event.preventDefault();
               const formato = document.getElementById('formato').value;
               const dataInicial =
                  document.getElementById('data_inicial').value;
               const dataFinal = document.getElementById('data_final').value;

               let url = `/tombos-usados/export?formato=${formato}`;
               if (dataInicial && dataFinal) {
                  if (new Date(dataInicial) > new Date(dataFinal)) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'A data inicial não pode ser posterior à data final.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                     return;
                  }
                  url += `&data_inicial=${dataInicial}&data_final=${dataFinal}`;
               }
               window.location.href = url;
            });

            // Evento para o botão "Reverter"
            const revertButtons = document.querySelectorAll('.btn-revert');
            revertButtons.forEach((button) => {
               button.addEventListener('click', async (event) => {
                  const itemId = event.target.getAttribute('data-id');
                  Swal.fire({
                     title: 'Confirmar Reversão',
                     text: 'Deseja realmente reverter a saída deste tombo? Ele será removido da tabela de tombos usados e retornará ao estoque.',
                     icon: 'warning',
                     showCancelButton: true,
                     confirmButtonText: 'Sim, reverter',
                     cancelButtonText: 'Cancelar',
                     confirmButtonColor: '#d33',
                     cancelButtonColor: '#3085d6',
                  }).then(async (result) => {
                     if (result.isConfirmed) {
                        try {
                           const response = await fetch(
                              `/tombos-usados/reverter/${itemId}`,
                              {
                                 method: 'DELETE',
                                 headers: {
                                    'Content-Type': 'application/json',
                                 },
                                 credentials: 'include',
                              }
                           );
                           if (!response.ok) {
                              throw new Error(`Erro: ${response.statusText}`);
                           }
                           const result = await response.json();
                           Swal.fire({
                              icon: 'success',
                              title: 'Sucesso!',
                              text: result.message,
                              timer: 2000,
                              timerProgressBar: true,
                              showConfirmButton: false,
                           }).then(() => {
                              // Remover a linha da tabela
                              event.target.closest('tr').remove();
                              // Verificar se a tabela ficou vazia
                              const tbody =
                                 document.getElementById('table-body');
                              if (tbody.children.length === 0) {
                                 tbody.innerHTML =
                                    '<tr><td colspan="9" class="text-center align-middle">Ainda não há tombos usados</td></tr>';
                              }
                           });
                        } catch (error) {
                           console.error('Erro ao reverter saída:', error);
                           Swal.fire({
                              icon: 'error',
                              title: 'Erro!',
                              text: 'Erro ao reverter a saída. Verifique o console para mais informações.',
                              timer: 3000,
                              timerProgressBar: true,
                              showConfirmButton: false,
                           });
                        }
                     }
                  });
               });
            });

            // Script para ordenação
            const sortStates = {};

            function sortTable(columnIndex, isNumeric = false) {
               const table = document.querySelector('.table');
               const tbody = table.querySelector('tbody');
               const rows = Array.from(tbody.getElementsByTagName('tr')).filter(
                  (row) => row.cells.length > 1
               );
               const th = document.querySelector(
                  `th[data-col="${columnIndex}"]`
               );
               const currentState = sortStates[columnIndex] || 'none';
               const newState = currentState === 'asc' ? 'desc' : 'asc';
               sortStates[columnIndex] = newState;

               // Atualizar indicadores visuais
               document.querySelectorAll('.sortable').forEach((header) => {
                  header.classList.remove('sort-asc', 'sort-desc');
               });
               th.classList.add(newState === 'asc' ? 'sort-asc' : 'sort-desc');

               rows.sort((a, b) => {
                  let aValue = a.cells[columnIndex].textContent.trim();
                  let bValue = b.cells[columnIndex].textContent.trim();

                  // Colunas numéricas: ID (0), Tombo (3)
                  if (columnIndex === 0 || columnIndex === 3) {
                     aValue = parseInt(aValue) || 0;
                     bValue = parseInt(bValue) || 0;
                     return newState === 'asc'
                        ? aValue - bValue
                        : bValue - aValue;
                  }
                  // Coluna de data: Saída (1)
                  else if (columnIndex === 1) {
                     const parseDate = (dateStr) => {
                        const [day, month, year] = dateStr
                           .split('/')
                           .map(Number);
                        return new Date(year, month - 1, day);
                     };
                     const aDate = parseDate(aValue);
                     const bDate = parseDate(bValue);
                     return newState === 'asc' ? aDate - bDate : bDate - aDate;
                  }
                  // Colunas de texto: Descrição (2), Doc. Saída (4), Valor (5)
                  else {
                     return newState === 'asc'
                        ? aValue.localeCompare(bValue, 'pt-BR')
                        : bValue.localeCompare(aValue, 'pt-BR');
                  }
               });

               rows.forEach((row) => tbody.appendChild(row));
            }

            // Adicionar eventos de clique aos cabeçalhos sortable
            document.querySelectorAll('.sortable').forEach((th) => {
               th.addEventListener('click', () => {
                  const columnIndex = parseInt(th.getAttribute('data-col'));
                  sortTable(columnIndex);
               });
            });
         });
      </script>
   </body>
</html>
