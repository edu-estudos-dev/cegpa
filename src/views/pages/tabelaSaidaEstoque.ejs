<!DOCTYPE html>
<html lang="pt-BR">
   <%- include('../partials/head', { title: 'Itens Pagos' }) %>

   <style>
      * {
         margin: 0;
         padding: 0;
      }

      body {
         padding-top: 2.5rem;
      }

      .botoes {
         margin-bottom: 1.9rem;
      }

      .table-container {
         max-height: 60vh;
         overflow-y: auto;
         overflow-x: hidden;
         min-height: 70vh;
      }

      .table-container table {
         width: 100%;
         border-collapse: separate;
         border-spacing: 0;
      }

      .table-container th,
      .table-container td {
         word-wrap: break-word;
         white-space: nowrap;
         border: none !important;
      }

      .table-container thead th {
         position: sticky;
         top: 0;
         background-color: rgb(231, 161, 9);
         color: white;
         border-left: 1px solid white !important;
         border-right: none !important;
         border-top: none !important;
         border-bottom: 1px solid white !important;
         z-index: 1;
      }

      .table-container thead th:last-child {
         border-right: none !important;
      }

      .btn-action {
         width: 70px;
      }

      .modal.fade .modal-dialog {
         transition: transform 0.25s ease-in-out, opacity 0.25s ease-in-out;
         transform: translateY(-10%);
         opacity: 0;
      }

      .modal.show .modal-dialog {
         transform: translateY(0);
         opacity: 1;
      }

      /* Ajuste das colunas */
      .table-container th:nth-child(1), /* ID */
      .table-container td:nth-child(1) {
         width: 3%;
      }

      .table-container th:nth-child(2), /* Saída */
      .table-container td:nth-child(2) {
         width: 5%;
      }

      .table-container th:nth-child(3), /* Descrição */
      .table-container td:nth-child(3) {
         width: 15%;
      }

      .table-container th:nth-child(4), /* Tombo */
      .table-container td:nth-child(4) {
         width: 5%;
      }

      .table-container th:nth-child(5), /* Destino */
      .table-container td:nth-child(5) {
         width: 5%;
      }

      .table-container th:nth-child(6), /* NUP */
      .table-container td:nth-child(6) {
         width: 5%;
      }

      .table-container th:nth-child(7), /* Termo de entrega */
      .table-container td:nth-child(7) {
         width: 8%;
      }

      .table-container th:nth-child(9), /* Valor */
      .table-container td:nth-child(9) {
         width: 5%;
      }

      .table-container th:last-child, /* Ações */
      .table-container td:last-child {
         width: 5%;
      }

      @media (max-width: 1920px) {
         .table-container {
            max-height: 56vh;
         }
      }

      .filter-container {
         display: flex;
         align-items: center;
         gap: 15px; /* Aumentado para melhor espaçamento */
         margin-bottom: 1rem;
         flex-wrap: wrap; /* Permite quebra de linha em telas pequenas */
      }

      .filter-container form {
         display: flex;
         align-items: center;
         gap: 15px;
         flex-wrap: nowrap; /* Evita quebra de linha dentro do formulário */
         margin-left: auto;
         margin-right: 1rem;
      }

      .filter-container label {
         margin-bottom: 0;
         font-weight: bold;
         font-size: 0.9rem;
         color: #333;
      }

      .filter-container input {
         padding: 0.375rem 0.5rem;
         font-size: 0.875rem;
         border-radius: 0.25rem;
         border: 1px solid #ced4da;
         width: 250px; /* Tamanho fixo para os inputs */
         transition: border-color 0.2s ease-in-out;
      }

      .filter-container input:focus {
         border-color: #007bff;
         outline: none;
         box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
      }

      .filter-container button {
         padding: 0.375rem 1rem;
         font-size: 0.875rem;
         white-space: nowrap;
      }

      /* Ajuste para telas menores */
      @media (max-width: 768px) {
         .filter-container form {
            flex-wrap: wrap;
            gap: 10px;
         }
         .filter-container input {
            width: 120px;
         }
      }

      /* Estilos para ordenação */
      .sortable {
         cursor: pointer;
         position: relative;
         padding-right: 30px;
      }

      .sortable::before,
      .sortable::after {
         content: '';
         position: absolute;
         right: 5px;
         width: 0;
         height: 0;
         border-left: 6px solid transparent;
         border-right: 6px solid transparent;
         opacity: 0.7;
         transition: opacity 0.3s ease, border-color 0.3s ease;
      }

      .sortable::before {
         border-bottom: 6px solid #ffffff;
         top: 8px;
      }

      .sortable::after {
         border-top: 6px solid #ffffff;
         bottom: 8px;
      }

      .sortable:hover::before,
      .sortable:hover::after {
         opacity: 1;
      }

      .sort-asc::before {
         border-bottom-color: #122dc4;
         opacity: 1;
      }

      .sort-asc::after {
         opacity: 0.7;
      }

      .sort-desc::after {
         border-top-color: #d40a0a;
         opacity: 1;
      }

      .sort-desc::before {
         opacity: 0.7;
      }
   </style>

   <body>
      <%- include('../partials/header') %>
      <div class="caixa p-4 mx-auto">
         <div class="border caixa-externa p-4 shadow-sm rounded">
            <div class="row align-items-center mb-3 px-3">
               <div
                  class="col d-flex justify-content-between align-items-center bg-success py-2 rounded"
                  style="border-bottom: 4px solid orange"
               >
                  <h2 class="text-white mt-0 fw-bold flex-grow-1 text-center">
                     Saídas do estoque
                  </h2>
                  <div class="d-flex align-items-center">
                     <label for="formato" class="text-white me-2"
                        >Formato:</label
                     >
                     <select
                        id="formato"
                        class="form-select form-select-md me-2"
                        style="width: auto"
                     >
                        <option value="pdf">PDF</option>
                        <option value="excel">Excel</option>
                     </select>
                     <a
                        href="#"
                        id="exportarBtn"
                        class="btn btn-outline-light btn-header fw-bold"
                        >Gerar Relatório</a
                     >
                  </div>
               </div>
            </div>
            <div class="filter-container">
               <form action="/estoque/itenspagos" method="GET" id="filterForm">
                  <label for="data_inicial">Data Inicial:</label>
                  <input
                     type="date"
                     id="data_inicial"
                     name="data_inicial"
                     class="form-control"
                     value="<%= data_inicial || '' %>"
                  />
                  <label for="data_final">Data Final:</label>
                  <input
                     type="date"
                     id="data_final"
                     name="data_final"
                     class="form-control"
                     value="<%= data_final || '' %>"
                  />
                  <button type="submit" id="filtrarBtn" class="btn btn-secondary">
                     Filtrar
                  </button>
               </form>
            </div>
            <div class="table-container">
               <table class="table table-striped table-hover mb-0">
                  <thead>
                     <tr>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="0"
                        >
                           ID
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="1"
                        >
                           Saída
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="2"
                        >
                           Descrição
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="3"
                        >
                           Tombo
                        </th>
                        <th class="text-center px-0 align-middle">Destino</th>
                        <th class="text-center px-0 align-middle">
                           NUP (Suite)
                        </th>
                        <th
                           class="text-center px-0 align-middle sortable"
                           data-col="4"
                        >
                           Termo de Entrega
                        </th>
                        <!-- <th class="text-center px-0 align-middle">Doc Origem</th> -->
                        <th class="text-center px-0 align-middle">Valor</th>
                        <th class="text-center px-0 align-middle">Açoes</th>
                     </tr>
                  </thead>
                  <tbody id="table-body">
                     <% if (itensPagos && itensPagos.length > 0) { %> <%
                     itensPagos.forEach(function(item) { %>
                     <tr>
                        <td class="py-1 text-center align-middle">
                           <%= item.id %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= new
                           Date(item.data_de_saida).toLocaleDateString('pt-BR')
                           %>
                        </td>
                        <td class="py-1 text-left align-middle">
                           <%= item.descricao.toUpperCase() %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= item.tombo_estoqueatual %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= item.destino.toUpperCase() %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= item.referencia.toUpperCase() %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= item.doc_saida.toUpperCase() %>
                        </td>
                        <!-- <td class="py-1 text-center align-middle">
                                 <%= item.doc_origem ? item.doc_origem.toUpperCase() : 'N/A' %>
                              </td> -->
                        <td class="py-1 text-center align-middle">
                           <% if (item.valor && !isNaN(parseFloat(item.valor)))
                           { %> <%=
                           parseFloat(item.valor).toLocaleString('pt-BR', {
                           style: 'currency', currency: 'BRL' }) %> <% } else {
                           %> R$ 0,00 <% } %>
                        </td>
                        <td class="py-1 text-center align-middle w-10">
                           <button
                              type="button"
                              class="btn btn-secondary btn-sm btn-action btn-details"
                              data-tombo="<%= item.tombo_estoqueatual %>"
                           >
                              Detalhes
                           </button>
                           <button
                              type="button"
                              class="btn btn-danger btn-sm btn-action btn-revert"
                              data-id="<%= item.id %>"
                           >
                              Reverter
                           </button>
                        </td>
                     </tr>
                     <% }); %> <% } else { %>
                     <tr>
                        <td colspan="10" class="text-center align-middle">
                           Ainda não há itens pagos
                        </td>
                     </tr>
                     <% } %>
                  </tbody>
               </table>
            </div>
         </div>
      </div>

      <!-- Incluindo o SweetAlert2 via CDN -->
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

      <!-- Scripts para Bootstrap -->
      <script
         src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
         integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
         crossorigin="anonymous"
      ></script>
      <script
         src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
         integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
         crossorigin="anonymous"
      ></script>

      <script>
         // Passa o role do usuário do backend para o JavaScript
         const userRole =
            '<%= typeof userRole !== "undefined" ? userRole : "user" %>';

         document.addEventListener('DOMContentLoaded', () => {

            const formatarMoeda = (valor) => {
               return parseFloat(valor).toLocaleString('pt-BR', {
                  style: 'currency',
                  currency: 'BRL',
               });
            };

            // Script para o botão "Detalhes"
            const viewButtons = document.querySelectorAll('.btn-details');

            viewButtons.forEach((button, index) => {
               button.addEventListener('click', async (event) => {

                  const tombo = event.target.getAttribute('data-tombo');

                  if (!tombo) {

                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Número do tombo não encontrado.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                     return;
                  }

                  try {
                     const response = await fetch(`/fetch-info-tombo?tombo=${tombo}`)

                     if (!response.ok) {
                        throw new Error(`Erro na requisição: ${response.status} ${response.statusText}`);
                     }

                     const data = await response.json();

                     const modalBody = document.getElementById('infoTomboModalBody');
                     if (!modalBody) {
                        throw new Error('Elemento do modal não encontrado');
                     }

                     if (data.infoTombo) {

                        const entrada = data.infoTombo;
                        const saida = data.infoSaida;
                        const dataEntradaFormatada = entrada.data_de_entrada
                           ? new Date(entrada.data_de_entrada).toLocaleDateString('pt-BR')
                           : 'N/A';
                        const dataSaidaFormatada = saida && saida.data_de_saida
                           ? new Date(saida.data_de_saida).toLocaleDateString('pt-BR')
                           : '';

                        modalBody.innerHTML = `
                           <div class="card">
                              <div class="card-body pb-0">
                                 <h5 class="card-title">${entrada.descricao || 'N/A'}</h5>
                                 <p class="card-text">
                                    <h5 class="bg-primary text-white p-2">Dados da Entrada</h5>
                                    <strong>Tombo:</strong> ${entrada.tombo || 'N/A'} <br/>
                                    <strong>Data de Entrada:</strong> ${dataEntradaFormatada} <br/>
                                    <strong>Categoria:</strong> ${entrada.categoria || 'N/A'} <br/>
                                    <strong>Doc Origem:</strong> ${entrada.doc_origem || 'N/A'} <br/>
                                    <strong>Estoque:</strong> ${entrada.estoque || 'N/A'} <br/>
                                    <strong>Valor:</strong> ${parseFloat(entrada.valor || 0).toLocaleString('pt-BR', {
                                       style: 'currency',
                                       currency: 'BRL',
                                    })} <br/>
                                    <strong>Situação:</strong> ${entrada.situacao || 'N/A'} <br/>
                                    <strong>Observação:</strong> ${entrada.observacao || 'N/A'} <br/>
                                    <hr style="border: 1px solid #ccc; margin: 1rem 0;">
                                    ${
                                       entrada.pago === 1
                                          ? saida
                                             ? `
                                          <h5 class="bg-danger text-white p-2">Dados da Saída</h5>
                                          <strong>Data de Saída:</strong> ${dataSaidaFormatada} <br/>
                                          <strong>Doc Saída:</strong> ${saida.doc_saida || 'N/A'} <br/>
                                          <strong>Referência:</strong> ${saida.referencia || 'N/A'} <br/>
                                          <strong>Destino:</strong> ${saida.destino ? saida.destino.toUpperCase() : 'N/A'} <br/>
                                          <strong>Posto/Graduação:</strong> ${saida.posto_graduacao ? saida.posto_graduacao.toUpperCase() : 'N/A'} <br/>
                                          <strong>Matrícula Funcional:</strong> ${saida.mat_funcional || 'N/A'} <br/>
                                          <strong>Telefone:</strong> ${saida.telefone || 'N/A'} <br/>
                                          <strong>Nome Completo:</strong> ${saida.nome_completo ? saida.nome_completo.toUpperCase() : 'N/A'} <br/>
                                          <strong>Observação de Saída:</strong> ${saida.observacao ? saida.observacao.toUpperCase() : 'N/A'} <br/>
                                       `
                                             : `
                                          <h5 class="bg-secondary text-white p-2">Item foi dado como pago, mas não há detalhes de saída.</h5>
                                       `
                                          : `
                                       <h5 class="bg-secondary text-white p-2">Item consta no estoque, ainda não foi pago.</h5>
                                    `
                                    }
                                 </p>
                              </div>
                           </div>
                        `;

                        // Verificar se o modal tem a classe modal-lg
                        const modalDialog = document.querySelector('#infoTomboModal .modal-dialog');
                        if (modalDialog && !modalDialog.classList.contains('modal-lg')) {
                           modalDialog.classList.add('modal-lg');
                        }

                        const infoTomboModalElement = document.getElementById('infoTomboModal');
                        if (!infoTomboModalElement) {
                           throw new Error('Modal infoTomboModal não encontrado');
                        }

                        const infoTomboModal = new bootstrap.Modal(infoTomboModalElement, {
                           backdrop: true,
                           focus: true,
                        });
                        infoTomboModal.show();

                        infoTomboModalElement.addEventListener('hidden.bs.modal', () => {
                           modalBody.innerHTML = '<div class="text-center text-muted">Carregando...</div>';
                        });
                     } else {
                        Swal.fire({
                           icon: 'error',
                           title: 'Erro!',
                           text: 'Desculpe, mas esse tombo é inválido ou ainda não foi cadastrado, tente novamente.',
                           timer: 3000,
                           timerProgressBar: true,
                           showConfirmButton: false,
                        });
                     }
                  } catch (error) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: `Erro ao carregar os detalhes do item: ${error.message}`,
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                  }
               });
            });

            // Validação do formulário antes do envio
            const filterForm = document.getElementById('filterForm');
            filterForm.addEventListener('submit', (event) => {
               const dataInicial =
                  document.getElementById('data_inicial').value;
               const dataFinal = document.getElementById('data_final').value;

               if (!dataInicial || !dataFinal) {
                  event.preventDefault();
                  Swal.fire({
                     icon: 'warning',
                     title: 'Atenção!',
                     text: 'Por favor, selecione ambas as datas inicial e final.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                  });
               } else if (new Date(dataInicial) > new Date(dataFinal)) {
                  event.preventDefault();
                  Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: 'A data inicial não pode ser posterior à data final.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false,
                  });
               }
            });

            // Evento para o botão "Exportar"
            const exportarBtn = document.getElementById('exportarBtn');
            exportarBtn.addEventListener('click', (event) => {
               event.preventDefault();
               const formato = document.getElementById('formato').value;
               const dataInicial =
                  document.getElementById('data_inicial').value;
               const dataFinal = document.getElementById('data_final').value;

               let url = `/relatorio/itens-pagos?formato=${formato}`;
               if (dataInicial && dataFinal) {
                  if (new Date(dataInicial) > new Date(dataFinal)) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'A data inicial não pode ser posterior à data final.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                     return;
                  }
                  url += `&data_inicial=${dataInicial}&data_final=${dataFinal}`;
               }
               window.location.href = url;
            });

            // Evento para o botão "Reverter"
            const revertButtons = document.querySelectorAll('.btn-revert');
            revertButtons.forEach((button) => {
               button.addEventListener('click', async (event) => {
                  const itemId = event.target.getAttribute('data-id');
                  Swal.fire({
                     title: 'Confirmar Reversão',
                     text: 'Deseja realmente reverter a saída deste item? Ele será removido da tabela de itens pagos e retornará ao estoque atual.',
                     icon: 'warning',
                     showCancelButton: true,
                     confirmButtonText: 'Sim, reverter',
                     cancelButtonText: 'Cancelar',
                     confirmButtonColor: '#d33',
                     cancelButtonColor: '#3085d6',
                  }).then(async (result) => {
                     if (result.isConfirmed) {
                        try {
                           const response = await fetch(
                              `/reverter-saida/${itemId}`,
                              {
                                 method: 'DELETE',
                                 headers: {
                                    'Content-Type': 'application/json',
                                 },
                                 credentials: 'include', // Adiciona cookies de sessão para autenticação
                              }
                           );
                           if (!response.ok) {
                              throw new Error(`Erro: ${response.statusText}`);
                           }
                           const result = await response.json();
                           Swal.fire({
                              icon: 'success',
                              title: 'Sucesso!',
                              text: result.message,
                              timer: 2000,
                              timerProgressBar: true,
                              showConfirmButton: false,
                           }).then(() => {
                              // Remover a linha da tabela
                              event.target.closest('tr').remove();
                              // Verificar se a tabela ficou vazia
                              const tbody =
                                 document.getElementById('table-body');
                              if (tbody.children.length === 0) {
                                 tbody.innerHTML =
                                    '<tr><td colspan="10" class="text-center align-middle">Ainda não há itens pagos</td></tr>';
                              }
                           });
                        } catch (error) {
                           Swal.fire({
                              icon: 'error',
                              title: 'Erro!',
                              text: 'Erro ao reverter a saída. Verifique o console para mais informações.',
                              timer: 3000,
                              timerProgressBar: true,
                              showConfirmButton: false,
                           });
                        }
                     }
                  });
               });
            });

            // Script para ordenação
            const sortStates = {};

            function sortTable(columnIndex, isNumeric = false) {
               const table = document.querySelector('.table');
               const tbody = table.querySelector('tbody');
               const rows = Array.from(tbody.getElementsByTagName('tr')).filter(
                  (row) => row.cells.length > 1
               ); // Exclui linhas vazias
               const th = document.querySelector(
                  `th[data-col="${columnIndex}"]`
               );
               const currentState = sortStates[columnIndex] || 'none';
               const newState = currentState === 'asc' ? 'desc' : 'asc';
               sortStates[columnIndex] = newState;

               // Atualizar indicadores visuais
               document.querySelectorAll('.sortable').forEach((header) => {
                  header.classList.remove('sort-asc', 'sort-desc');
               });
               th.classList.add(newState === 'asc' ? 'sort-asc' : 'sort-desc');

               rows.sort((a, b) => {
                  let aValue = a.cells[columnIndex].textContent.trim();
                  let bValue = b.cells[columnIndex].textContent.trim();

                  // Colunas numéricas: ID (0), Tombo (3)
                  if (columnIndex === 0 || columnIndex === 3) {
                     aValue = parseInt(aValue) || 0;
                     bValue = parseInt(bValue) || 0;
                     return newState === 'asc'
                        ? aValue - bValue
                        : bValue - aValue;
                  }
                  // Coluna de data: Saída (1)
                  else if (columnIndex === 1) {
                     const parseDate = (dateStr) => {
                        const [day, month, year] = dateStr
                           .split('/')
                           .map(Number);
                        return new Date(year, month - 1, day);
                     };
                     const aDate = parseDate(aValue);
                     const bDate = parseDate(bValue);
                     return newState === 'asc' ? aDate - bDate : bDate - aDate;
                  }
                  // Colunas de texto: Descrição (2), Termo de Entrega (4)
                  else {
                     return newState === 'asc'
                        ? aValue.localeCompare(bValue, 'pt-BR')
                        : bValue.localeCompare(aValue, 'pt-BR');
                  }
               });

               rows.forEach((row) => tbody.appendChild(row));
            }

            // Adicionar eventos de clique aos cabeçalhos sortable
            document.querySelectorAll('.sortable').forEach((th) => {
               th.addEventListener('click', () => {
                  const columnIndex = parseInt(th.getAttribute('data-col'));
                  sortTable(columnIndex);
               });
            });
         });
      </script>
   </body>
</html>
