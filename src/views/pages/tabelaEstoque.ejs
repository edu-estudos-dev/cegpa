<!DOCTYPE html>
<html lang="pt-BR">
   <%- include('../partials/head', { title: 'Estoque Atual' }) %>

   <style>
      /* Estilos existentes do tabelaEstoque.ejs */
     * {
         margin: 0;
         padding: 0;
         box-sizing: border-box;
      }

      body {
         padding-top: 2.5rem;
         overflow: hidden;
         height: 100vh;
         margin: 0;
      }

      .caixa {
         height: calc(100vh - 2.5rem);
         display: flex;
         flex-direction: column;
      }

      .caixa-externa {
         flex: 1;
         overflow: hidden;
         display: flex;
         flex-direction: column;
         margin-top: 2rem;
      }

      .botoes {
         margin-bottom: 1.9rem;
      }

      .table-container {
         flex: 1;
         overflow-y: auto;
         overflow-x: hidden;
         max-height: none;
         min-height: 0;
      }

      .table-container table {
         width: 100%;
         border-collapse: separate;
         border-spacing: 0;
      }

      .table-container th,
      .table-container td {
         word-wrap: break-word;
         white-space: nowrap;
         border: none !important;
      }

      .table-container thead th {
         position: sticky;
         top: 0;
         background-color: rgb(231, 161, 9);
         color: white;
         border-left: 1px solid white !important;
         border-right: none !important;
         border-top: none !important;
         border-bottom: 1px solid white !important;
         z-index: 1;
      }

      .table-container thead th:last-child {
         border-right: none !important;
      }

      .btn-details,
      .btn-edit,
      .btn-delete,
      .btn-reservar {
         width: 70px;
      }

      .modal.fade .modal-dialog {
         transition: transform 0.25s ease-in-out, opacity 0.25s ease-in-out;
         transform: translateY(-10%);
         opacity: 0;
      }

      .modal.show .modal-dialog {
         transform: translateY(0);
         opacity: 1;
      }

      .table-container th:nth-child(1),
      .table-container td:nth-child(1) {
         width: 4%;
      }

      .table-container th:nth-child(2),
      .table-container td:nth-child(2) {
         width: 6%;
      }

      .table-container th:nth-child(3),
      .table-container td:nth-child(3) {
         width: 20%;
      }

      .table-container th:nth-child(4),
      .table-container td:nth-child(4) {
         width: 7%;
      }

      .table-container th:nth-child(5),
      .table-container td:nth-child(5) {
         width: 10%;
      }

      .table-container th:nth-child(6),
      .table-container td:nth-child(6) {
         width: 7%;
      }

      .table-container th:nth-child(7),
      .table-container td:nth-child(7) {
         width: 7%;
      }

      .table-container th:nth-child(8),
      .table-container td:nth-child(8) {
         width: 8%;
      }

      .table-container th:nth-child(9),
      .table-container td:nth-child(9) {
         width: 7%;
      }

      .table-container th:last-child,
      .table-container td:last-child {
         width: 10%;
      }

      .table-container #estoqueTable tbody tr {
         transition: opacity 0.3s ease;
      }

      .table-container #estoqueTable tbody tr.hidden {
         display: none;
         opacity: 0;
      }

      .sortable {
         cursor: pointer;
         position: relative;
         padding-right: 30px;
      }

      .sortable::before,
      .sortable::after {
         content: '';
         position: absolute;
         right: 5px;
         width: 0;
         height: 0;
         border-left: 6px solid transparent;
         border-right: 6px solid transparent;
         opacity: 0.7;
         transition: opacity 0.3s ease, border-color 0.3s ease;
      }

      .sortable::before {
         border-bottom: 6px solid #ffffff;
         top: 8px;
      }

      .sortable::after {
         border-top: 6px solid #ffffff;
         bottom: 8px;
      }

      .sortable:hover::before,
      .sortable:hover::after {
         opacity: 1;
      }

      .sort-asc::before {
         border-bottom-color: #122dc4;
         opacity: 1;
      }

      .sort-asc::after {
         opacity: 0.7;
      }

      .sort-desc::after {
         border-top-color: #d40a0a;
         opacity: 1;
      }

      .sort-desc::before {
         opacity: 0.7;
      }

      .w-5 {
         width: 5%;
      }

      @media (max-width: 1024px) {
         .caixa-externa {
            background-color: #d40a0a;
         }
      }

      .filter-container {
         display: flex;
         align-items: center;
         gap: 15px;
         margin-bottom: 1rem;
         flex-wrap: wrap;
      }

      .filter-container form {
         display: flex;
         align-items: center;
         gap: 15px;
         flex-wrap: nowrap;
         margin-left: auto;
         margin-right: 1rem;
      }

      .filter-container label {
         margin-bottom: 0;
         font-weight: bold;
         font-size: 0.9rem;
         color: #333;
      }

      .filter-container input {
         padding: 0.375rem 0.5rem;
         font-size: 0.875rem;
         border-radius: 0.25rem;
         border: 1px solid #ced4da;
         width: 250px;
         transition: border-color 0.2s ease-in-out;
      }

      .filter-container input:focus {
         border-color: #007bff;
         outline: none;
         box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
      }

      .filter-container button {
         padding: 0.375rem 1rem;
         font-size: 0.875rem;
         white-space: nowrap;
      }

      @media (max-width: 768px) {
         .filter-container form {
            flex-wrap: wrap;
            gap: 10px;
         }
         .filter-container input {
            width: 120px;
         }
      }
   </style>

   <body>
      <%- include('../partials/header') %>
      <div class="caixa p-4 mx-auto">
         <div class="border caixa-externa p-4 shadow-sm rounded">
            <div class="row align-items-center mb-3 px-3">
               <div
                  class="col d-flex justify-content-between align-items-center bg-success py-2 rounded"
                  style="border-bottom: 4px solid orange"
               >
                  <h2 class="text-white mt-0 fw-bold flex-grow-1 text-center">
                     Estoque Atual
                  </h2>
                  <div class="d-flex align-items-center">
                     <label for="formato" class="text-white me-2"
                        >Formato:</label
                     >
                     <select
                        id="formato"
                        class="form-select form-select-md me-2"
                        style="width: auto"
                     >
                        <option value="pdf">PDF</option>
                        <option value="excel">Excel</option>
                     </select>
                     <a
                        href="#"
                        id="exportarBtn"
                        class="btn btn-outline-light btn-header fw-bold"
                        >Gerar Relatório</a
                     >
                  </div>
               </div>
            </div>

            <div class="filter-container">
               <form action="#" id="filterForm">
                  <label for="searchTombo" class="fw-bold">Pesquisar:</label>
                  <input
                     type="text"
                     id="searchTombo"
                     name="search"
                     class="form-control"
                     placeholder="Digite o número do tombo, categoria, descrição, etc."
                     value=""
                  />
                  <button type="button" id="clearSearch" class="btn btn-secondary">
                     Limpar
                  </button>
               </form>
            </div>

            <div class="table-container">
               <table
                  id="estoqueTable"
                  class="table table-striped table-hover mb-0"
               >
                  <thead class="thead-success">
                     <tr class="table-borderless">
                        <th
                           class="text-center table-borderless px-0 sortable"
                           data-col="0"
                        >
                           ID
                        </th>
                        <th
                           class="text-center table-borderless px-0 sortable"
                           data-col="1"
                        >
                           Entrada
                        </th>
                        <th
                           class="ps-4 text-center table-borderless px-0 sortable"
                           data-col="2"
                        >
                           Descrição
                        </th>
                        <th
                           class="text-center table-borderless px-0 sortable"
                           data-col="3"
                        >
                           Tombo
                        </th>
                        <th class="text-center table-borderless px-0">
                           Categoria
                        </th>
                        <th class="text-center table-borderless px-0">
                           Estoque
                        </th>
                        <th class="text-center table-borderless px-0">
                           Conservação
                        </th>
                        <th class="text-center table-borderless px-0">
                           Doc de Origem
                        </th>
                        <th class="text-center table-borderless px-0">Valor</th>
                        <th class="text-center table-borderless px-0">Ações</th>
                     </tr>
                  </thead>
                  <tbody>
                     <% if (estoque.length > 0) { %>
                     <% estoque.forEach(function(item) { %>
                     <tr>
                        <td class="py-1 align-middle text-center">
                           <%= item.id %>
                        </td>
                        <td class="py-1 text-center align-middle">
                           <%= item.data_de_entrada_formatada %>
                        </td>
                        <td class="py-1 align-middle"><%= item.descricao %></td>
                        <td class="py-1 align-middle text-center">
                           <%= item.tombo %>
                        </td>
                        <td class="py-1 align-middle text-center">
                           <%= item.categoria %>
                        </td>
                        <td class="py-1 align-middle text-center">
                           <%= item.estoque %>
                        </td>
                        <td class="py-1 align-middle text-center">
                           <%= item.situacao %>
                        </td>
                        <td class="py-1 align-middle text-center">
                           <%= item.doc_origem %>
                        </td>
                        <td
                           class="py-1 align-middle text-center valor-cell"
                           data-valor="<%= item.valor %>"
                        >
                           <%= item.valor %>
                        </td>
                        <td class="py-1 align-middle text-center">
                           <button
                              type="button"
                              class="btn btn-secondary btn-sm btn-details"
                              data-tombo="<%= item.tombo %>"
                           >
                              Detalhes
                           </button>
                           <a
                              href="/editar/<%= item.id %>"
                              class="btn btn-warning btn-sm btn-edit"
                              >Editar</a
                           >
                           <a
                              href="/excluir/<%= item.id %>"
                              class="btn btn-danger btn-sm btn-delete"
                              data-id="<%= item.id %>"
                              >Excluir</a
                           >
                           <% if (!item.pago && !item.reservado) { %>
                           <button
                              type="button"
                              class="btn btn-primary btn-sm btn-reservar"
                              data-id="<%= item.id %>"
                              data-tombo="<%= item.tombo %>"
                              data-descricao="<%= item.descricao %>"
                              data-categoria="<%= item.categoria %>"
                              data-valor="<%= item.valor %>"
                              data-situacao="<%= item.situacao %>"
                              data-doc_origem="<%= item.doc_origem %>"
                              data-estoque="<%= item.estoque %>"
                              data-data_entrada="<%= item.data_de_entrada_formatada %>"
                           >
                              Reservar
                           </button>
                           <% } %>
                        </td>
                     </tr>
                     <% }); %>
                     <% } else { %>
                     <tr>
                        <td colspan="10" class="text-center align-middle">
                           Ainda não há itens cadastrados
                        </td>
                     </tr>
                     <% } %>
                  </tbody>
               </table>
            </div>
         </div>
      </div>

      <!-- Modal para o formulário de reserva -->
      <div class="modal fade" id="reservaModal" tabindex="-1" aria-labelledby="reservaModalLabel" aria-hidden="true">
         <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
               <div class="modal-header bg-primary text-white d-flex justify-content-between">
                  <h3 class="modal-title ms-3" id="reservaModalLabel">Reservar Item</h3>
                  <button type="button" class="btn text-white" data-bs-dismiss="modal" aria-label="Close">
                     <i class="fa fa-times fa-lg"></i>
                  </button>
               </div>
               <div class="modal-body">
                  <form id="reservaForm">
                     <div class="card">
                        <div class="card-body pb-0">
                           <h5 class="card crotch-title" id="reservaDescricao"></h5>
                           <p class="card-text">
                              <h5 class="bg-primary text-white p-2">Dados do Item</h5>
                              <strong>ID:</strong> <span id="reservaId"></span> <br/>
                              <strong>Tombo:</strong> <span id="reservaTombo"></span> <br/>
                              <strong>Data de Entrada:</strong> <span id="reservaDataEntrada"></span> <br/>
                              <strong>Categoria:</strong> <span id="reservaCategoria"></span> <br/>
                              <strong>Doc Origem:</strong> <span id="reservaDocOrigem"></span> <br/>
                              <strong>Estoque:</strong> <span id="reservaEstoque"></span> <br/>
                              <strong>Valor:</strong> <span id="reservaValor"></span> <br/>
                              <strong>Situação:</strong> <span id="reservaSituacao"></span> <br/>
                           </p>
                           <div class="mb-3">
                              <label for="reservaDestino" class="form-label fw-bold">Destino da Reserva:</label>
                              <input type="text" class="form-control" id="reservaDestino" name="destino" required placeholder="Digite o destino (ex.: Unidade X)">
                           </div>
                        </div>
                     </div>
                     <button type="submit" class="btn btn-success mt-3">Fazer Reserva</button>
                  </form>
               </div>
            </div>
         </div>
      </div>

      <!-- Incluindo o SweetAlert2 via CDN -->
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

      <!-- Scripts para Bootstrap -->
      <script
         src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
         integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
         crossorigin="anonymous"
      ></script>
      <script
         src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
         integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
         crossorigin="anonymous"
      ></script>

      <script>
         // Passa o role do usuário do backend para o JavaScript
         const userRole = '<%= userRole %>';

         document.addEventListener('DOMContentLoaded', () => {
            // Função para formatar valores no padrão de moeda brasileira
            const formatarMoeda = (valor) => {
               return parseFloat(valor).toLocaleString('pt-BR', {
                  style: 'currency',
                  currency: 'BRL',
               });
            };

            // Formata os valores na coluna "Valor"
            const valorCells = document.querySelectorAll('.valor-cell');
            valorCells.forEach((cell) => {
               const valor = cell.getAttribute('data-valor');
               if (valor) {
                  cell.textContent = formatarMoeda(valor);
               }
            });

            // Função para formatar a data
            function formatarData(data) {
               if (!data) return 'N/A';
               const d = new Date(data);
               if (isNaN(d.getTime())) return 'N/A';
               return d.toLocaleDateString('pt-BR');
            }

            // Script para o botão "Detalhes"
            const viewButtons = document.querySelectorAll('.btn-details');
            viewButtons.forEach((button, index) => {
               button.addEventListener('click', async (event) => {
                  const tombo = event.target.getAttribute('data-tombo');
                  if (!tombo) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Número do tombo não encontrado.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false
                     });
                     return;
                  }

                  try {
                     const response = await fetch(`/fetch-info-tombo?tombo=${tombo}`);
                     if (!response.ok) {
                        throw new Error(`Erro na requisição: ${response.status} ${response.statusText}`);
                     }

                     const data = await response.json();
                     const modalBody = document.getElementById('infoTomboModalBody');
                     if (!modalBody) {
                        throw new Error('Elemento do modal não encontrado');
                     }

                     if (data.infoTombo) {
                        const entrada = data.infoTombo;
                        const saida = data.infoSaida;
                        const dataEntradaFormatada = entrada.data_de_entrada ? new Date(entrada.data_de_entrada).toLocaleDateString('pt-BR') : 'N/A';
                        const dataSaidaFormatada = saida && saida.data_de_saida ? new Date(saida.data_de_saida).toLocaleDateString('pt-BR') : '';

                        modalBody.innerHTML = `
                           <div class="card">
                              <div class="card-body pb-0">
                                 <h5 class="card-title">${entrada.descricao || 'N/A'}</h5>
                                 <p class="card-text">
                                    <h5 class="bg-primary text-white p-2">Dados da Entrada</h5>
                                    <strong>Tombo:</strong> ${entrada.tombo || 'N/A'} <br/>
                                    <strong>Data de Entrada:</strong> ${dataEntradaFormatada} <br/>
                                    <strong>Categoria:</strong> ${entrada.categoria || 'N/A'} <br/>
                                    <strong>Doc Origem:</strong> ${entrada.doc_origem || 'N/A'} <br/>
                                    <strong>Estoque:</strong> ${entrada.estoque || 'N/A'} <br/>
                                    <strong>Valor:</strong> ${parseFloat(entrada.valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })} <br/>
                                    <strong>Situação:</strong> ${entrada.situacao || 'N/A'} <br/>
                                    <strong>Observação:</strong> ${entrada.observacao || 'N/A'} <br/>
                                    <hr>
                                    ${entrada.pago === 1 ? (saida ? `
                                       <h5 class="bg-danger text-white p-2">Dados da Saída</h5>
                                       <strong>Data de Saída:</strong> ${dataSaidaFormatada} <br/>
                                       <strong>Doc Saída:</strong> ${saida.doc_saida || 'N/A'} <br/>
                                       <strong>Referência:</strong> ${saida.referencia || 'N/A'} <br/>
                                       <strong>Destino:</strong> ${saida.destino ? saida.destino.toUpperCase() : 'N/A'} <br/>
                                       <strong>Posto/Graduação:</strong> ${saida.posto_graduacao ? saida.posto_graduacao.toUpperCase() : 'N/A'} <br/>
                                       <strong>Matrícula Funcional:</strong> ${saida.mat_funcional || 'N/A'} <br/>
                                       <strong>Telefone:</strong> ${saida.telefone || 'N/A'} <br/>
                                       <strong>Nome Completo:</strong> ${saida.nome_completo ? saida.nome_completo.toUpperCase() : 'N/A'} <br/>
                                       <strong>Observação de Saída:</strong> ${saida.observacao ? saida.observacao.toUpperCase() : 'N/A'} <br/>
                                    ` : `
                                       <h5 class="bg-secondary text-white p-2">Item foi dado como pago, mas não há detalhes de saída.</h5>
                                    `) : `
                                       <h5 class="bg-secondary text-white p-2">Item consta no estoque, ainda não foi pago.</h5>
                                    `}
                                 </p>
                              </div>
                           </div>
                        `;

                        const infoTomboModalElement = document.getElementById('infoTomboModal');
                        if (!infoTomboModalElement) {
                           throw new Error('Modal infoTomboModal não encontrado');
                        }

                        const infoTomboModal = new bootstrap.Modal(infoTomboModalElement, {
                           backdrop: true,
                           focus: true
                        });

                        infoTomboModal.show();
                        infoTomboModalElement.addEventListener('hidden.bs.modal', () => {
                           modalBody.innerHTML = '<div class="text-center text-muted">Carregando...</div>';
                        });
                     } else {
                        Swal.fire({
                           icon: 'error',
                           title: 'Erro!',
                           text: 'Desculpe, mas esse tombo é inválido ou ainda não foi cadastrado, tente novamente.',
                           timer: 3000,
                           timerProgressBar: true,
                           showConfirmButton: false
                        });
                     }
                  } catch (error) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: `Erro ao carregar os detalhes do item: ${error.message}`,
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false
                     });
                  }
               });
            });

            // Script para o botão "Exportar Relatório"
            const exportarBtn = document.getElementById('exportarBtn');
            exportarBtn.addEventListener('click', (event) => {
               event.preventDefault();
               const formato = document.getElementById('formato').value;
               window.location.href = `/relatorio/geral?formato=${formato}`;
            });

            // Script para os botões "Editar" e "Excluir"
            const editButtons = document.querySelectorAll('.btn-edit');
            const deleteButtons = document.querySelectorAll('.btn-delete');

            editButtons.forEach((button) => {
               button.addEventListener('click', (event) => {
                  if (userRole !== 'admin') {
                     event.preventDefault();
                     Swal.fire({
                        icon: 'error',
                        title: 'Acesso Negado!',
                        text: 'Você não tem permissão para editar itens. Apenas administradores podem realizar esta ação.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                  }
               });
            });

            deleteButtons.forEach((button) => {
               button.addEventListener('click', async (event) => {
                  event.preventDefault();
                  const itemId = button.getAttribute('data-id');
                  const url = `/excluir/${itemId}`;

                  if (userRole !== 'admin') {
                     Swal.fire({
                        icon: 'error',
                        title: 'Acesso Negado!',
                        text: 'Você não tem permissão para excluir itens. Apenas administradores podem realizar esta ação.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                     return;
                  }

                  const result = await Swal.fire({
                     title: 'Confirmar exclusão',
                     text: 'Você tem certeza que deseja excluir este item? Esse processo é irreversível.',
                     icon: 'question',
                     showCancelButton: true,
                     confirmButtonText: 'Sim',
                     cancelButtonText: 'Não',
                     confirmButtonColor: '#28a745',
                     cancelButtonColor: '#dc3545',
                  });

                  if (!result.isConfirmed) {
                     return;
                  }

                  try {
                     const response = await fetch(url, { method: 'DELETE' });
                     if (!response.ok) {
                        const result = await response.json();
                        throw new Error(result.msg || 'Erro ao excluir item');
                     }

                     Swal.fire({
                        icon: 'success',
                        title: 'Sucesso!',
                        text: 'Item excluído com sucesso!',
                        timer: 2000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     }).then(() => {
                        location.reload();
                     });
                  } catch (error) {
                     console.error('Erro ao excluir item:', error);
                     Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text:
                           error.message ||
                           'Não foi possível excluir o item. Tente novamente.',
                        timer: 3000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                     });
                  }
               });
            });

            // Script para pesquisa
            document
               .getElementById('searchTombo')
               .addEventListener('input', function () {
                  const searchTerm = this.value.toLowerCase().trim();
                  filterRows(searchTerm);
               });

            document
               .getElementById('clearSearch')
               .addEventListener('click', () => {
                  document.getElementById('searchTombo').value = '';
                  filterRows('');
               });

            function filterRows(searchTerm) {
               const table = document.getElementById('estoqueTable');
               const rows = table.getElementsByTagName('tr');

               const removerAcentos = (str) => {
                  return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
               };

               const normalizedSearchTerm = removerAcentos(
                  searchTerm.toLowerCase().trim()
               );

               for (let i = 1; i < rows.length; i++) {
                  const cells = rows[i].getElementsByTagName('td');
                  if (cells.length < 8) {
                     rows[i].classList.add('hidden');
                     continue;
                  }

                  const descricaoCell = removerAcentos(
                     cells[2].textContent.toLowerCase().trim()
                  );
                  const tomboCell = removerAcentos(
                     cells[3].textContent.toLowerCase().trim()
                  );
                  const categoriaCell = removerAcentos(
                     cells[4].textContent.toLowerCase().trim()
                  );
                  const estoqueCell = removerAcentos(
                     cells[5].textContent.toLowerCase().trim()
                  );
                  const conservacaoCell = removerAcentos(
                     cells[6].textContent.toLowerCase().trim()
                  );
                  const docOrigemCell = removerAcentos(
                     cells[7].textContent.toLowerCase().trim()
                  );

                  const matches =
                     descricaoCell.includes(normalizedSearchTerm) ||
                     tomboCell.includes(normalizedSearchTerm) ||
                     categoriaCell.includes(normalizedSearchTerm) ||
                     estoqueCell.includes(normalizedSearchTerm) ||
                     conservacaoCell.includes(normalizedSearchTerm) ||
                     docOrigemCell.includes(normalizedSearchTerm);

                  if (searchTerm === '' || matches) {
                     rows[i].classList.remove('hidden');
                  } else {
                     rows[i].classList.add('hidden');
                  }
               }
            }

            // Script para ordenação
            const sortStates = {};
            function sortTable(columnIndex, isNumeric = false) {
               const table = document.getElementById('estoqueTable');
               const tbody = table.querySelector('tbody');
               const rows = Array.from(tbody.getElementsByTagName('tr')).filter(
                  (row) => !row.classList.contains('hidden')
               );
               const th = document.querySelector(
                  `th[data-col="${columnIndex}"]`
               );
               const currentState = sortStates[columnIndex] || 'none';
               const newState = currentState === 'asc' ? 'desc' : 'asc';
               sortStates[columnIndex] = newState;

               document.querySelectorAll('.sortable').forEach((header) => {
                  header.classList.remove('sort-asc', 'sort-desc');
               });
               th.classList.add(newState === 'asc' ? 'sort-asc' : 'sort-desc');

               rows.sort((a, b) => {
                  let aValue = a.cells[columnIndex].textContent.trim();
                  let bValue = b.cells[columnIndex].textContent.trim();
                  if (columnIndex === 0 || columnIndex === 3) {
                     aValue = parseInt(aValue) || 0;
                     bValue = parseInt(bValue) || 0;
                     return newState === 'asc'
                        ? aValue - bValue
                        : bValue - aValue;
                  } else if (columnIndex === 1) {
                     const parseDate = (dateStr) => {
                        const [day, month, year] = dateStr
                           .split('/')
                           .map(Number);
                        return new Date(year, month - 1, day);
                     };
                     const aDate = parseDate(aValue);
                     const bDate = parseDate(bValue);
                     return newState === 'asc' ? aDate - bDate : bDate - aDate;
                  } else {
                     return newState === 'asc'
                        ? aValue.localeCompare(bValue, 'pt-BR')
                        : bValue.localeCompare(aValue, 'pt-BR');
                  }
               });

               rows.forEach((row) => tbody.appendChild(row));
            }

            document.querySelectorAll('.sortable').forEach((th) => {
               th.addEventListener('click', () => {
                  const columnIndex = parseInt(th.getAttribute('data-col'));
                  sortTable(columnIndex);
               });
            });

            // Script para o botão "Reservar"
            const reservaButtons = document.querySelectorAll('.btn-reservar');
            reservaButtons.forEach((button) => {
               button.addEventListener('click', (event) => {
                  const itemId = button.getAttribute('data-id');
                  const tombo = button.getAttribute('data-tombo');
                  const descricao = button.getAttribute('data-descricao');
                  const categoria = button.getAttribute('data-categoria');
                  const valor = button.getAttribute('data-valor');
                  const situacao = button.getAttribute('data-situacao');
                  const docOrigem = button.getAttribute('data-doc_origem');
                  const estoque = button.getAttribute('data-estoque');
                  const dataEntrada = button.getAttribute('data-data_entrada');

                  // Preencher o modal com os dados do item
                  document.getElementById('reservaId').textContent = itemId || 'N/A';
                  document.getElementById('reservaTombo').textContent = tombo || 'N/A';
                  document.getElementById('reservaDescricao').textContent = descricao || 'N/A';
                  document.getElementById('reservaCategoria').textContent = categoria || 'N/A';
                  document.getElementById('reservaValor').textContent = valor ? formatarMoeda(valor) : 'N/A';
                  document.getElementById('reservaSituacao').textContent = situacao || 'N/A';
                  document.getElementById('reservaDocOrigem').textContent = docOrigem || 'N/A';
                  document.getElementById('reservaEstoque').textContent = estoque || 'N/A';
                  document.getElementById('reservaDataEntrada').textContent = dataEntrada || 'N/A';
                  document.getElementById('reservaDestino').value = '';

                  // Abrir o modal
                  const reservaModal = new bootstrap.Modal(document.getElementById('reservaModal'), {
                     backdrop: true,
                     focus: true
                  });
                  reservaModal.show();
               });
            });

            // Script para o formulário de reserva
            document.getElementById('reservaForm').addEventListener('submit', async (event) => {
               event.preventDefault();
               const itemId = document.getElementById('reservaId').textContent;
               const destino = document.getElementById('reservaDestino').value.trim();

               if (!destino) {
                  Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: 'Por favor, preencha o campo de destino.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false
                  });
                  return;
               }

               try {
                  const response = await fetch('/reservar', {
                     method: 'POST',
                     headers: {
                        'Content-Type': 'application/json'
                     },
                     body: JSON.stringify({ itemId, destino })
                  });

                  if (!response.ok) {
                     const result = await response.json();
                     throw new Error(result.msg || 'Erro ao realizar a reserva');
                  }

                  Swal.fire({
                     icon: 'success',
                     title: 'Sucesso!',
                     text: 'Item reservado com sucesso!',
                     timer: 2000,
                     timerProgressBar: true,
                     showConfirmButton: false
                  }).then(() => {
                     location.reload();
                  });
               } catch (error) {
                  Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: error.message || 'Não foi possível reservar o item. Tente novamente.',
                     timer: 3000,
                     timerProgressBar: true,
                     showConfirmButton: false
                  });
               }
            });
         });
      </script>
   </body>
</html>